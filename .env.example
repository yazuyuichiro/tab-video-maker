# 設定のひな形。このファイルを .env にコピーして値を記入してください（.env は GitHub に公開されません）
# Cloudflare Pages では、同じ名前の環境変数をダッシュボードの「設定 → 環境変数」に登録してください

# 運営者名とお問い合わせ先（プライバシーポリシーに表示。AdSense 審査前に記入してください）
VITE_OPERATOR_NAME=
VITE_CONTACT=

# Google AdSense（審査に通ったら記入）
# 例: VITE_ADSENSE_CLIENT=ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=
# エディタ下の横長バナーの広告ユニットID（例: 1234567890）
VITE_ADSENSE_SLOT=
